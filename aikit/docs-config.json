{
  "$schema": "./docs-config.schema.json",
  "version": "1.0.0",
  "description": "AIKit Documentation Configuration - Controls platform visibility",
  "platforms": {
    "antigravity": {
      "enabled": true,
      "label": "Google Antigravity",
      "badge": "NEW",
      "badgeColor": "gradient",
      "showInNav": true,
      "showInQuickStart": true,
      "showInInstallation": true,
      "featured": true,
      "betaWarning": "Google Antigravity - The next generation AI coding experience from Google DeepMind."
    },
    "opencode": {
      "enabled": true,
      "label": "OpenCode",
      "badge": "stable",
      "badgeColor": "green",
      "showInNav": true,
      "showInQuickStart": true,
      "showInInstallation": true
    },
    "cursor": {
      "enabled": true,
      "label": "Cursor",
      "badge": "popular",
      "badgeColor": "purple",
      "showInNav": true,
      "showInQuickStart": true,
      "showInInstallation": true
    },
    "claude": {
      "enabled": false,
      "label": "Claude Code",
      "badge": "Beta",
      "badgeColor": "yellow",
      "showInNav": true,
      "showInQuickStart": true,
      "showInInstallation": true,
      "betaWarning": "Claude Code support is in Beta. Some features may be limited or experimental."
    }
  },
  "navigation": {
    "showPlatformTabs": true,
    "defaultPlatform": "antigravity",
    "showBothPlatforms": true,
    "platformSwitcherText": "Switch Platform:",
    "hideDisabledPlatform": false
  },
  "sections": {
    "installation": {
      "showBothPlatforms": true,
      "defaultTo": "opencode"
    },
    "quickStart": {
      "showBothPlatforms": true
    },
    "commands": {
      "showBothPlatforms": true
    },
    "skills": {
      "showBothPlatforms": true
    },
    "agents": {
      "showBothPlatforms": true
    },
    "oneShot": {
      "showBothPlatforms": true
    },
    "sessionManagement": {
      "showBothPlatforms": false,
      "platformsToShow": [
        "opencode"
      ]
    }
  },
  "toggles": {
    "showClaudeCode": true,
    "showBetaBadges": true,
    "showPlatformComparison": true,
    "defaultClaudeVisible": true
  },
  "ui": {
    "badgeStyles": {
      "NEW": {
        "text": "NEW",
        "bgColor": "linear-gradient(135deg, #4285f4, #ea4335, #fbbc04, #34a853)",
        "textColor": "#ffffff",
        "animated": true
      },
      "recommended": {
        "text": "recommended",
        "bgColor": "#16a34a",
        "textColor": "#ffffff"
      },
      "stable": {
        "text": "stable",
        "bgColor": "#16a34a",
        "textColor": "#ffffff"
      },
      "popular": {
        "text": "popular",
        "bgColor": "#8b5cf6",
        "textColor": "#ffffff"
      },
      "beta": {
        "text": "Beta",
        "bgColor": "#f59e0b",
        "textColor": "#ffffff"
      }
    },
    "platformTabs": {
      "antigravity": {
        "icon": "🚀",
        "color": "linear-gradient(135deg, #4285f4, #ea4335)",
        "featured": true
      },
      "opencode": {
        "icon": "🔵",
        "color": "#3b82f6"
      },
      "cursor": {
        "icon": "🟣",
        "color": "#8b5cf6"
      },
      "claude": {
        "icon": "🟡",
        "color": "#eab308"
      }
    }
  },
  "notes": {
    "howToHideAntigravity": "Set platforms.antigravity.enabled to false to hide Antigravity from documentation",
    "howToShowAntigravity": "Set platforms.antigravity.enabled to true to show Antigravity in documentation",
    "howToHideClaude": "Set platforms.claude.enabled to false to hide Claude Code from documentation",
    "howToShowClaude": "Set platforms.claude.enabled to true to show Claude Code in documentation",
    "howToHideCursor": "Set platforms.cursor.enabled to false to hide Cursor from documentation",
    "howToShowCursor": "Set platforms.cursor.enabled to true to show Cursor in documentation",
    "quickToggleGuide": "Use aikit CLI commands: aikit platform enable/disable <platform>",
    "configLocation": "document/aikit/docs-config.json"
  }
}